datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  SITE_ENGINEER
  STORE_MANAGER
}

enum VentureStatus {
  DRAFT
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum VentureType {
  RESIDENTIAL
  COMMERCIAL
  VILLA
  APARTMENT
  PLOT_DEVELOPMENT
  INDUSTRIAL
  INFRASTRUCTURE
  RENOVATION
  MIXED_USE
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
  ON_LEAVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  STOCK_TRANSFER
}

enum DocumentCategory {
  LEGAL
  DRAWINGS
  APPROVALS
  CONTRACTS
  MATERIAL_DOCS
  SITE_PHOTOS
  REPORTS
  OTHER
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             UserRole          @default(SITE_ENGINEER)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  employee         Employee?
  auditLogs        AuditLog[]
  transactions     MaterialTransaction[]
  chatMembers      ChatMember[]
  messages         ChatMessage[]
  messageReads     MessageRead[]
  notifications    Notification[]
  approvedRequests MaterialRequest[]  @relation("ApprovedRequests")
  createdRequests  MaterialRequest[]  @relation("CreatedRequests")

  @@map("users")
}

model Venture {
  id                      String            @id @default(uuid())
  name                    String
  code                    String            @unique
  type                    VentureType       @default(RESIDENTIAL)
  description             String?
  status                  VentureStatus     @default(ACTIVE)
  
  // Registered Address
  regAddressLine1         String?
  regAddressLine2         String?
  regCity                 String?
  regDistrict             String?
  regState                String?
  regCountry              String?           @default("India")
  regPincode              String?

  // Construction Site Address
  siteAddressLine1        String?
  siteAddressLine2        String?
  siteCity                String?
  siteDistrict            String?
  siteState               String?
  siteCountry             String?           @default("India")
  sitePincode             String?
  latitude                Float?
  longitude               Float?
  mapUrl                  String?

  // Timeline
  planningStartDate       DateTime?
  startDate               DateTime?
  expectedCompletionDate  DateTime?
  actualCompletionDate    DateTime?
  handoverDate            DateTime?

  // Finance / Budget Summary
  estimatedBudget         Float?            @default(0)
  budgetCurrency          String            @default("INR")
  progressPercentage      Float             @default(0)

  // Leadership Foreign Keys (Optional references to Employee)
  projectDirectorId       String?
  projectDirector         Employee?         @relation("ProjectDirector", fields: [projectDirectorId], references: [id], onDelete: SetNull)
  projectManagerId        String?
  projectManager          Employee?         @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  siteManagerId           String?
  siteManager             Employee?         @relation("SiteManager", fields: [siteManagerId], references: [id], onDelete: SetNull)
  constructionManagerId   String?
  constructionManager     Employee?         @relation("ConstructionManager", fields: [constructionManagerId], references: [id], onDelete: SetNull)
  financeManagerId        String?
  financeManager          Employee?         @relation("FinanceManager", fields: [financeManagerId], references: [id], onDelete: SetNull)
  purchaseManagerId       String?
  purchaseManager         Employee?         @relation("PurchaseManager", fields: [purchaseManagerId], references: [id], onDelete: SetNull)

  // Archival
  archivedAt              DateTime?
  archivedBy              String?

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  // Relations
  assignments             EmployeeVentureAssignment[]
  stocks                  MaterialStock[]
  transactions            MaterialTransaction[]
  requests                MaterialRequest[]
  chatRooms               ChatRoom[]
  auditLogs               AuditLog[]
  documents               VentureDocument[]
  announcements           VentureAnnouncement[]
  settings                VentureSetting?

  @@map("ventures")
}

model Employee {
  id                     String                      @id @default(uuid())
  employeeId             String                      @unique
  userId                 String?                     @unique
  user                   User?                       @relation(fields: [userId], references: [id])
  firstName              String
  lastName               String
  designation            String
  department             String
  status                 EmployeeStatus              @default(ACTIVE)
  onboardingStage        String                      @default("Active")
  onboardingStatus       String                      @default("Active")
  phone                  String?
  email                  String?
  joiningDate            String?
  reportingManager       String?
  employmentType         String?
  attendanceRate         String?                     @default("100%")
  performanceRating      Float?                      @default(5.0)
  leaveBalancePaid       Int?                        @default(12)
  leaveBalanceSick       Int?                        @default(8)
  leaveBalanceCasual     Int?                        @default(10)
  activitiesJson         String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  documents              EmployeeDocument[]
  assignments            EmployeeVentureAssignment[]
  skills                 EmployeeSkill[]
  certifications         EmployeeCertification[]

  // Leadership relations
  directedVentures       Venture[]                   @relation("ProjectDirector")
  managedVentures        Venture[]                   @relation("ProjectManager")
  siteManagedVentures    Venture[]                   @relation("SiteManager")
  constructionManagedVentures Venture[]               @relation("ConstructionManager")
  financeManagedVentures Venture[]                   @relation("FinanceManager")
  purchaseManagedVentures Venture[]                  @relation("PurchaseManager")

  @@map("employees")
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  fileUrl    String
  fileType   String
  createdAt  DateTime @default(now())

  @@map("employee_documents")
}

model EmployeeSkill {
  id                 String           @id @default(uuid())
  employeeId         String
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill              String
  category           String           @default("Civil")
  proficiency        String           @default("Intermediate") // Beginner, Intermediate, Expert
  experienceYears    Int              @default(0)
  verificationStatus String           @default("Pending")      // Verified, Pending, Rejected
  verifiedBy         String?
  verificationDate   DateTime?
  createdAt          DateTime         @default(now())

  @@map("employee_skills")
}

model EmployeeCertification {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certification String
  certificateNo String
  issueDate     DateTime  @default(now())
  expiryDate    DateTime
  status        String    @default("Valid") // Valid, Expiring Soon, Expired
  authority     String    @default("National Safety Agency")
  createdAt     DateTime  @default(now())

  @@map("employee_certifications")
}

model EmployeeVentureAssignment {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ventureId   String
  venture     Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  roleAtSite  String?
  accessLevel String   @default("STANDARD") // e.g. FULL_ACCESS, OPERATIONS, MATERIALS_ONLY, READ_ONLY
  startDate   DateTime @default(now())
  endDate     DateTime?
  status      String   @default("ACTIVE")
  assignedAt  DateTime @default(now())

  @@unique([employeeId, ventureId])
  @@map("employee_venture_assignments")
}

model VentureDocument {
  id           String           @id @default(uuid())
  ventureId    String
  venture      Venture          @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  title        String
  category     DocumentCategory @default(OTHER)
  fileUrl      String
  fileType     String
  fileSize     Int              @default(0)
  uploadedById String?
  version      String           @default("1.0")
  visibility   String           @default("ALL") // e.g. ALL, MANAGEMENT, SITE_TEAM
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("venture_documents")
}

model VentureAnnouncement {
  id          String               @id @default(uuid())
  ventureId   String
  venture     Venture              @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  title       String
  message     String
  priority    AnnouncementPriority @default(NORMAL)
  audience    String               @default("ALL") // e.g. ALL, MANAGEMENT, SITE_STAFF
  createdById String?
  publishDate DateTime             @default(now())
  expiryDate  DateTime?
  createdAt   DateTime             @default(now())

  @@map("venture_announcements")
}

model VentureSetting {
  id                           String   @id @default(uuid())
  ventureId                    String   @unique
  venture                      Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  minStockThresholdDefault     Float    @default(50)
  requireMaterialApproval      Boolean  @default(true)
  allowEmployeeSelfAssignment  Boolean  @default(false)
  allowFileUploadInChat        Boolean  @default(true)
  notifyOnLowStock             Boolean  @default(true)
  notifyOnMaterialRequests     Boolean  @default(true)
  updatedAt                    DateTime @updatedAt

  @@map("venture_settings")
}

model MaterialCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  materials Material[]

  @@map("material_categories")
}

model UnitOfMeasure {
  id        String     @id @default(uuid())
  name      String     @unique
  materials Material[]

  @@map("units_of_measure")
}

model Material {
  id               String           @id @default(uuid())
  name             String
  code             String           @unique
  categoryId       String
  category         MaterialCategory @relation(fields: [categoryId], references: [id])
  unitOfMeasureId  String
  unitOfMeasure    UnitOfMeasure    @relation(fields: [unitOfMeasureId], references: [id])
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  stocks           MaterialStock[]
  transactions     MaterialTransaction[]
  requestItems     MaterialRequestItem[]

  @@map("materials")
}

model MaterialStock {
  id         String   @id @default(uuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  ventureId  String
  venture    Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  quantity   Float    @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([materialId, ventureId])
  @@map("material_stocks")
}

model MaterialTransaction {
  id          String          @id @default(uuid())
  materialId  String
  material    Material        @relation(fields: [materialId], references: [id])
  ventureId   String
  venture     Venture         @relation(fields: [ventureId], references: [id])
  quantity    Float
  type        TransactionType
  referenceId String?
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  remarks     String?
  createdAt   DateTime        @default(now())

  @@map("material_transactions")
}

model MaterialRequest {
  id           String               @id @default(uuid())
  ventureId    String
  venture      Venture              @relation(fields: [ventureId], references: [id])
  status       RequestStatus        @default(PENDING)
  remarks      String?
  createdById  String
  createdBy    User                 @relation("CreatedRequests", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?                @relation("ApprovedRequests", fields: [approvedById], references: [id])
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  items        MaterialRequestItem[]

  @@map("material_requests")
}

model MaterialRequestItem {
  id         String          @id @default(uuid())
  requestId  String
  request    MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  materialId String
  material   Material        @relation(fields: [materialId], references: [id])
  quantity   Float

  @@map("material_request_items")
}

model ChatRoom {
  id        String       @id @default(uuid())
  ventureId String?
  venture   Venture?     @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())
  members   ChatMember[]
  messages  ChatMessage[]

  @@map("chat_rooms")
}

model ChatMember {
  id         String   @id @default(uuid())
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@unique([roomId, userId])
  @@map("chat_members")
}

model ChatMessage {
  id          String              @id @default(uuid())
  roomId      String
  room        ChatRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime            @default(now())
  attachments MessageAttachment[]
  reads       MessageRead[]

  @@map("chat_messages")
}

model MessageAttachment {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int

  @@map("message_attachments")
}

model MessageRead {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime    @default(now())

  @@unique([messageId, userId])
  @@map("message_reads")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String
  ventureId String?
  venture   Venture? @relation(fields: [ventureId], references: [id])
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

