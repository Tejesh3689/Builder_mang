# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://builder_admin:builder_password@localhost:5432/builder_management?schema=public"

# Redis Cache and Queue Configuration
REDIS_URL="redis://localhost:6379"

# NextAuth / Auth Configuration
NEXTAUTH_SECRET="super-secret-nextauth-key-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# File Storage Configuration (AWS S3 / Cloudflare R2)
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="builder-management-assets"
# R2 custom endpoint if using Cloudflare R2
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# Server Port
PORT=3000

# App Environment (development, staging, production)
NODE_ENV="development"
